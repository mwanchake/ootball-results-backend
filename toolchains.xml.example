<?xml version="1.0" encoding="UTF-8"?>
<!--
  Example ~/.m2/toolchains.xml to point Maven to a local JDK 21 installation.
  Place this file at: C:\Users\<your-user>\.m2\toolchains.xml
  Update <jdkHome> to your actual JDK 21 install path.
-->
<toolchains xmlns="http://maven.apache.org/TOOLCHAINS/1.1.0"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://maven.apache.org/TOOLCHAINS/1.1.0 https://maven.apache.org/xsd/toolchains-1.1.0.xsd">
  <toolchain>
    <type>jdk</type>
    <provides>
      <version>21</version>
      <vendor>any</vendor>
    </provides>
    <configuration>
      <!-- Replace this path with the absolute path to your JDK 21 installation -->
      <jdkHome>C:\Program Files\Java\jdk-21</jdkHome>
    </configuration>
  </toolchain>
</toolchains>
